# Compose interpolation only. scripts/dev/bootstrap-local.sh writes local UID/GID.
APP_UID=65532
APP_GID=65532

# Required only with deploy/compose.production.yaml. DNS must point to the deployment host.
PUBLIC_DOMAIN=
MAX_APP_BOT_USERNAME=

# Optional: exact browser origins separated by commas; empty for same origin/proxy.
# Local example: http://localhost:5173,http://127.0.0.1:5173
# Production origins must use HTTPS.
CORS_ALLOWED_ORIGINS=

# Optional: path to compiled frontend assets for deploy/compose.frontend.yaml.
FRONTEND_DIST=./frontend/dist

# The actual secret files live under .local/secrets/ and are never committed.
# For production, replace every local-only secret before launch.
